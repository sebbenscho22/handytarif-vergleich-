# Vorlage: kopieren nach .env.local (wird nicht committet) und Werte eintragen.
# Zu finden in der Firebase-Konsole unter Projekteinstellungen → Allgemein → Meine Apps → SDK-Konfiguration.
# Diese Werte sind öffentlich (sie stehen später im Browser-Code). Geschützt wird über Login und firebase/firestore.rules.
VITE_FIREBASE_API_KEY=PLATZHALTER
VITE_FIREBASE_AUTH_DOMAIN=PLATZHALTER.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PLATZHALTER
VITE_FIREBASE_APP_ID=PLATZHALTER
